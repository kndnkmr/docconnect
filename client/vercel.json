{
  "functions": {
    "api/dr/[slug].js": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    { "source": "/dr/:slug", "destination": "/api/dr/:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(login|register|dashboard|admin|book-appointment|booking-confirmation|forgot-password|reset-password|verify-email)(/.*)?",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    }
  ]
}
